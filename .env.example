# Шаблон переменных окружения бэкенда. Скопируйте в .env и заполните.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# Порт HTTP-сервера (по умолчанию 3156)
PORT=3156

# Строка подключения к MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/wtfgames

# Секрет для подписи JWT (HS256). Обязателен, длинная случайная строка.
JWT_PRIVATE=change-me-to-a-long-random-secret

# Окружение: development | production
NODE_ENV=development

# --- Аутентификация по httpOnly-cookie ---

# Разрешённые origin'ы фронтенда (через запятую) для CORS с credentials.
# В dev при использовании CRA-прокси кросс-доменных запросов нет, но значение
# всё равно нужно для прямых обращений.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ставить ли флаг Secure на cookie. true — только по HTTPS (обязательно в prod).
# В dev по http оставляйте false.
COOKIE_SECURE=false

# SameSite для auth-cookie: lax (same-origin/через прокси в dev) |
# none (кросс-доменный prod, требует COOKIE_SECURE=true) | strict
COOKIE_SAMESITE=lax
