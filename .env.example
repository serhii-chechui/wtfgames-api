# Backend environment template. Copy to .env and fill in the values.
# .env is not committed (see .gitignore).

# HTTP server port (default 3156)
PORT=3156

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/wtfgames

# JWT signing secret (HS256). Required — a long random string.
JWT_PRIVATE=change-me-to-a-long-random-secret

# Environment: development | production
NODE_ENV=development

# Log level: error | warn | info | http | verbose | debug (default: info in
# production, debug otherwise)
LOG_LEVEL=debug

# --- httpOnly cookie authentication ---

# Allowed frontend origins (comma-separated) for CORS with credentials. In dev
# with the CRA proxy there are no cross-origin requests, but the value is still
# needed for direct calls.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Whether to set the Secure flag on cookies. true = HTTPS only (required in
# prod). Leave false for dev over http.
COOKIE_SECURE=false

# SameSite for the auth cookie: lax (same-origin / via proxy in dev) |
# none (cross-domain prod, requires COOKIE_SECURE=true) | strict
COOKIE_SAMESITE=lax

# --- AWS S3 (file uploads) ---
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# --- Email (nodemailer via Gmail) ---
# Gmail address and an app password (not the account password).
ADMIN_MAIL=your-address@gmail.com
ADMIN_PASS=your-gmail-app-password
